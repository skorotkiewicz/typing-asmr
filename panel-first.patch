 * { box-sizing: border-box; }
 html, body { height: 100%; }
 body { margin: 0; background: var(--desk); color: var(--ink); font: 15px/1.45 var(--sans); }
-.layout { display: grid; grid-template-columns: 380px 1fr; gap: 20px; min-height: 100%; padding: 20px; }
-.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 20px; align-self: start; display: grid; gap: 16px; max-height: calc(100vh - 40px); overflow: auto; }
+.layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 20px; min-height: 100%; padding: 20px; max-width: 1100px; margin: 0 auto; }
+.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 28px; align-self: start; display: grid; gap: 18px; }
 h1 { margin: 0; font: 600 22px/1.2 var(--serif); }
 .field { display: grid; gap: 6px; border: 0; padding: 0; margin: 0; min-width: 0; }
 .field > span, legend { font-weight: 600; padding: 0; margin-bottom: 4px; }
@@ -55,17 +55,17 @@ button.secondary { background: var(--paper); color: var(--ink); border-color: va
 button:disabled { opacity: .45; cursor: not-allowed; }
 button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, summary:focus-visible, .page:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
 .status { margin: 0; color: var(--muted); min-height: 1.4em; }
-.desk { display: grid; grid-template-rows: 1fr auto; gap: 12px; min-height: 0; }
-.page { background: var(--paper); border: 1px solid var(--line); border-radius: 14px; padding: clamp(20px, 4vw, 56px); font: 20px/1.7 var(--serif); white-space: pre-wrap; overflow-wrap: anywhere; overflow: auto; height: calc(100vh - 100px); max-width: 72ch; width: 100%; justify-self: center; }
+.desk { display: grid; gap: 10px; align-self: start; position: sticky; top: 20px; }
+.page { background: var(--paper); border: 1px solid var(--line); border-radius: 14px; padding: 18px; font: 15px/1.6 var(--serif); white-space: pre-wrap; overflow-wrap: anywhere; overflow: auto; height: min(60vh, 460px); width: 100%; }
 .caret { display: inline-block; width: 2px; height: 1.2em; margin-left: 1px; vertical-align: text-bottom; background: var(--accent); animation: blink 1.05s steps(1) infinite; }
 .caret.typing { animation: none; }
 @keyframes blink { 50% { opacity: 0; } }
-.meter { display: flex; gap: 12px; align-items: center; justify-self: center; width: min(72ch, 100%); color: var(--muted); font-variant-numeric: tabular-nums; }
+.meter { display: flex; gap: 12px; align-items: center; color: var(--muted); font-variant-numeric: tabular-nums; }
 .bar { flex: 1; height: 4px; background: var(--line); border-radius: 4px; overflow: hidden; }
 .bar i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .15s linear; }
 @media (max-width: 860px) {
   .layout { grid-template-columns: 1fr; }
-  .panel { max-height: none; }
-  .page { height: 60vh; }
+  .desk { position: static; }
+  .page { height: 35vh; }
 }
 @media (prefers-reduced-motion: reduce) { .caret { animation: none; } .bar i { transition: none; } }
